# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# App Version
APP_VERSION=1.0.0

# Map Configuration (optional - for custom tile servers)
# NEXT_PUBLIC_TILE_SERVER_URL=https://your-tile-server.com/{z}/{x}/{y}.png

# API Configuration (if using custom geocoding API)
# NEXT_PUBLIC_GEOCODING_API_URL=https://your-api.com/geocode
# GEOCODING_API_KEY=your-api-key

# Performance & Monitoring
NEXT_TELEMETRY_DISABLED=1

# Docker Configuration
APP_HTTP_PORT=3000

# Production Configuration (for docker-compose.production.yml)
# DOMAIN=your-domain.com
# ACME_EMAIL=admin@your-domain.com
